        <mxCell id="b2" value="&lt;b&gt;load_policy_docs()&lt;/b&gt;&amp;nbsp; helpcenter.py:35&lt;br&gt;glob *.md → split on &quot;---&quot; → yaml.safe_load&lt;br&gt;→ PolicyDoc(policy_id, title, audience, body, path)&lt;br&gt;sorted by policy_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacing=10;" vertex="1" parent="21">
          <mxGeometry x="420" y="130" width="380" height="90" as="geometry" />
