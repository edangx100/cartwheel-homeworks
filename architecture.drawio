        <mxCell id="bsub" value="agent/helpcenter.py — instructor-provided. One document = one BM25 unit: no chunking, no embeddings, no vector store." style="text;html=1;fontSize=13;align=left;fontColor=#666666;" vertex="1" parent="21">
          <mxGeometry x="60" y="62" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="&lt;b&gt;data/policies/*.md&lt;/b&gt;&lt;br&gt;18 markdown files&lt;br&gt;YAML front matter + body" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="21">
